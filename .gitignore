# ==============================================================================
# Sinozia Showcase - Git Ignore Configuration
# ==============================================================================

# Environment files & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.cer
*.crt
*.jks
*.keystore
auth.json

# API Collections, Environments & Exports
*.postman_collection.json
*.postman_environment.json
*.insomnia.json
*.har

# Deployment files, local server configs & backups
deploy*.txt
deploy*.sh
deploy*.php
*.bak
*.backup
*.zip
*.tar.gz
*.apk
*.aab
*.ipa

# Dependencies & Package Managers
/vendor/
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts & Frontend Bundles
/public/build/
/public/hot/
/public/storage

# Framework & Runtime Cache
.phpunit.cache/
.phpunit.result.cache
.phpactor.json
/bootstrap/cache/*
!/bootstrap/cache/.gitignore
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*.log
!/storage/logs/.gitignore
*.log

# User Uploads & Media Files
/public/uploads/*
!/public/uploads/.gitkeep
!/public/uploads/.gitignore
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/app/temp/*
!/storage/app/temp/.gitignore

# Database dumps & local storage files
*.sql
*.sqlite
*.sqlite-journal
*.db

# Operating System & Editor Files
.DS_Store
Thumbs.db
ehthumbs.db
/.idea/
/.vscode/
/.fleet/
/.zed/
/.nova/
Homestead.json
Homestead.yaml
